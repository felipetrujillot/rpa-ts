/* Fixed JXA worker. Workbook data arrives as UTF-8 JSON on stdin. */
ObjC.import('Foundation');
ObjC.import('AppKit');
var excel = Application('com.microsoft.Excel');
var books = {}, mutation = false, written = 0, processIdentity = null;
function reject(message) { throw new Error(message); }
function scalar(value) { while (Array.isArray(value)) value = value[0]; return value; }
function col(n) { var s = ''; while (n) { n--; s = String.fromCharCode(65 + n % 26) + s; n = Math.floor(n / 26); } return s; }
function dimensions(a) {
  var m = a.replace(/\$/g, '').toUpperCase().match(/^([A-Z]+)(\d+)(?::([A-Z]+)(\d+))?$/);
  function c(s) { return s.split('').reduce(function(n, x) { return n * 26 + x.charCodeAt(0) - 64; }, 0); }
  var x = c(m[1]), y = Number(m[2]);
  return { x: x, y: y, rows: Number(m[4] || m[2]) - y + 1, columns: c(m[3] || m[1]) - x + 1 };
}
function exclusive() {
  if (processIdentity && !excel.running()) { mutation = true; reject('Excel se cerró; la sesión necesita reconciliación.'); }
  var all = excel.workbooks() || [];
  var processes = $.NSRunningApplication.runningApplicationsWithBundleIdentifier('com.microsoft.Excel');
  if (Number(processes.count) !== 1) { mutation = true; reject('No se puede identificar una instancia única de Excel.'); }
  var nativeProcess = processes.objectAtIndex(0);
  var identity = String(nativeProcess.processIdentifier) + ':' + String(nativeProcess.launchDate.timeIntervalSince1970);
  if (processIdentity && identity !== processIdentity) { mutation = true; reject('Excel se reinició; las referencias fueron invalidadas.'); }
  processIdentity = identity;
  for (var i = 0; i < all.length; i++) {
    var path = all[i].fullName();
    var found = Object.keys(books).some(function(id) { return books[id].fullName === path; });
    if (!found) reject('Hay libros ajenos abiertos. Cierra los libros del usuario antes de automatizar Excel en macOS.');
  }
}
function bookFor(id) {
  var b = books[id];
  if (!b) reject('Libro no administrado.');
  if (!b.ref.exists() || b.ref.fullName() !== b.fullName) reject('La identidad del libro cambió; referencia invalidada.');
  return b;
}
function sheets(b) {
  var all = b.ref.worksheets() || [];
  return all.map(function(s, i) {
    // The stored object specifier remains tied to this execution; never use activeWorksheet.
    var id = b.id + ':sheet:' + s.name();
    b.sheets[id] = s;
    return { worksheetId: id, name: s.name(), visibility: String(s.visible()).replace('sheet ', '').replace(' ', '-') };
  });
}
function sheetFor(b, id) {
  sheets(b);
  var s = b.sheets[id];
  if (!s) { var matches = b.ref.worksheets.whose({name: id})() || []; if (matches.length === 1) s = matches[0]; }
  if (!s || !s.exists()) reject('Hoja no encontrada en el libro.');
  return s;
}
function cellTarget(b, s, addr) {
  return "'[" + b.ref.name().replace(/'/g, "''") + "]" + s.name().replace(/'/g, "''") + "'!" + addr;
}
function perform(request) {
  var p = request.input, action = request.action;
  exclusive();
  if (action === 'excel.workbook.open') {
    mutation = true;
    var w = excel.openWorkbook({workbookFileName: p.path, updateLinks: 'do not update links', readOnly: false, ignoreReadOnlyRecommended: true, editable: true, notify: false, addToMru: false});
    var b = { id: p.workbookId, ref: w, fullName: w.fullName(), sheets: {}, dirty: true };
    books[p.workbookId] = b;
    if (w.readOnly() || w.hasVbProject()) reject('Libro de solo lectura o con macros no soportado.');
    return { dateSystem: w.date1904() ? '1904' : '1900', excelVersion: excel.version() };
  }
  var b = bookFor(p.workbookId), w = b.ref;
  if (action === 'excel.worksheet.list') return { worksheets: sheets(b) };
  if (action === 'excel.worksheet.add') {
    if (w.protectStructure()) reject('La estructura del libro está protegida.');
    if (w.worksheets.name().some(function(n) { return n.toLowerCase() === p.name.toLowerCase(); })) reject('Nombre de hoja duplicado.');
    mutation = true; b.dirty = true;
    excel.make({new: 'worksheet', at: w, withProperties: {name: p.name}});
    var list = sheets(b); return list.filter(function(s) { return s.name === p.name; })[0];
  }
  if (action === 'excel.workbook.calculate') {
    if (excel.workbooks.length !== 1) reject('El cálculo aislado requiere un único libro abierto.');
    mutation = true;
    // Synchronous Apple event; only one managed workbook exists, including all sheet dependencies.
    // Full dependency rebuild is synchronous and only touches the sole managed book.
    excel.calculateFullRebuild(); b.dirty = false;
    return { calculationPending: false };
  }
  if (action === 'excel.workbook.saveAs') {
    mutation = true;
    excel.saveWorkbookAs(w, {filename: p.path, fileFormat: 'Excel XML file format', addToMostRecentlyUsedList: false});
    var saved = (excel.workbooks() || []).filter(function(candidate) { return candidate.fullName().normalize('NFC') === p.path.normalize('NFC'); });
    if (saved.length !== 1) reject('No se pudo verificar el libro después de guardar.');
    b.ref = saved[0]; b.fullName = b.ref.fullName(); b.sheets = {};
    return { path: p.path };
  }
  if (action === 'excel.workbook.close') {
    mutation = true; excel.close(w, {saving: p.saveChanges ? 'yes' : 'no'}); delete books[p.workbookId]; return { closed: true };
  }
  var s = sheetFor(b, p.worksheetId);
  if (String(s.visible()) !== 'sheet visible') reject('Las operaciones de rango y PDF requieren una hoja visible.');
  var r = s.ranges.byName(p.address), d = dimensions(p.address);
  // Validate every cell before the first modification; mixed merged ranges return missing values.
  for (var row = 0; row < d.rows; row++) for (var column = 0; column < d.columns; column++) {
    var c = s.ranges.byName(col(d.x + column) + (d.y + row));
    if (c.mergeCells() || c.hasArray()) reject('Rango con celdas combinadas no soportado.');
  }
  if (action !== 'excel.range.read' && s.protectContents()) reject('La hoja está protegida.');
  if (action === 'excel.range.read') {
    var values = [], types = [], formulas = [], errors = [];
    for (var row = 0; row < d.rows; row++) {
      var vr = [], tr = [], fr = [], er = [];
      for (var column = 0; column < d.columns; column++) {
        var addr = col(d.x + column) + (d.y + row), c = s.ranges.byName(addr);
        var target = cellTarget(b, s, addr);
        var empty = scalar(excel.evaluate({name: 'ISBLANK(' + target + ')'}));
        var error = scalar(excel.evaluate({name: 'ISERROR(' + target + ')'}));
        var v = empty || error ? null : scalar(c.value2());
        vr.push(v); tr.push(empty ? 'empty' : error ? 'error' : typeof v);
        fr.push(c.hasFormula() ? scalar(c.formula()) : null); er.push(error ? String(scalar(c.stringValue())) : null);
      }
      values.push(vr); types.push(tr); formulas.push(fr); errors.push(er);
    }
    return { values: values, types: types, formulas: formulas, errors: errors, dateSystem: w.date1904() ? '1904' : '1900', calculationPending: b.dirty };
  }
  if (action === 'excel.range.writeValues' || action === 'excel.range.writeFormulas') {
    var data = p.values || p.formulas;
    mutation = true; b.dirty = true;
    for (var row = 0; row < d.rows; row++) for (var column = 0; column < d.columns; column++) {
      var c = s.ranges.byName(col(d.x + column) + (d.y + row)), value = data[row][column];
      if (p.formulas) c.formula = value;
      else if (value === null) excel.clearContents(c);
      else if (typeof value === 'string') {
        // Prefix forces literal strings, including empty text and leading formula characters.
        c.value2 = "'" + value;
        if (c.hasFormula() || scalar(c.value2()) !== value) reject('Excel no conservó el texto literal.');
      } else c.value2 = value;
      written++;
    }
    return { writtenCells: written };
  }
  if (action === 'excel.range.clear') { mutation = true; b.dirty = true; excel.clearContents(r); return { cleared: true }; }
  if (action === 'excel.range.format') {
    mutation = true;
    var f = p.format;
    if (f.numberFormat !== undefined) r.numberFormat = f.numberFormat;
    if (f.bold !== undefined) r.fontObject.bold = f.bold;
    if (f.fill !== undefined) r.interiorObject.color = [parseInt(f.fill.slice(1, 3), 16), parseInt(f.fill.slice(3, 5), 16), parseInt(f.fill.slice(5, 7), 16)];
    if (f.columnWidth !== undefined) r.columnWidth = f.columnWidth;
    return { formatted: true };
  }
  if (action === 'excel.worksheet.exportPdf') {
    if (b.dirty) reject('Recalcula antes de exportar PDF.');
    mutation = true;
    var existingBooks = excel.workbooks.fullName();
    excel.copyWorksheet(s);
    var copies = (excel.workbooks() || []).filter(function(candidate) { return existingBooks.indexOf(candidate.fullName()) === -1; });
    if (copies.length !== 1) reject('No se pudo identificar el libro temporal de exportación.');
    var pdfBook = copies[0];
    try {
      var page = pdfBook.worksheets[0].pageSetupObject;
      page.printArea = p.address;
      page.pageOrientation = p.page.orientation === 'landscape' ? 'landscape' : 'portrait';
      page.zoom = false; page.fitToPagesWide = p.page.fitToPagesWide; page.fitToPagesTall = p.page.fitToPagesTall;
      excel.saveWorkbookAs(pdfBook, {filename: p.path, fileFormat: 'PDF file format'});
    } finally { excel.close(pdfBook, {saving: 'no'}); }
    return { path: p.path };
  }
  reject('Acción no soportada.');
}
var stdin = $.NSFileHandle.fileHandleWithStandardInput;
var stdout = $.NSFileHandle.fileHandleWithStandardOutput;
while (true) {
  var buffer = $.NSMutableData.data;
  while (true) {
    var data = stdin.availableData;
    if (Number(data.length) === 0) break;
    buffer.appendData(data);
    var text = ObjC.unwrap($.NSString.alloc.initWithDataEncoding(buffer, $.NSUTF8StringEncoding));
    if (text && text.charAt(text.length - 1) === '\n') break;
  }
  if (Number(buffer.length) === 0) break;
  var request, response; mutation = false; written = 0;
  try {
    request = JSON.parse(ObjC.unwrap($.NSString.alloc.initWithDataEncoding(buffer, $.NSUTF8StringEncoding)));
    response = { id: request.id, ok: true, output: perform(request) };
  } catch (error) {
    response = { id: request && request.id, ok: false, error: (request && request.action) + ': ' + String(error.message || error) + (written ? ' Celdas escritas: ' + written : ''), effect: mutation ? 'uncertain' : 'none' };
  }
  stdout.writeData($(JSON.stringify(response) + '\n').dataUsingEncoding($.NSUTF8StringEncoding));
}
