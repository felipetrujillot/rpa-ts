{
  "name": "@rpa/robot",
  "productName": "rpa-robot-electron-vite-vue3-ts",
  "version": "0.1.0",
  "description": "My Electron application description",
  "main": "./out/main/main.js",
  "scripts": {
    "test:word": "vitest run --config vitest.word.config.ts",
    "test:word:probe": "node --test scripts/word/probe.test.mjs",
    "test:word:real": "node scripts/word/probe.mjs",
    "start": "electron-vite preview",
    "prestart": "npm run build --workspace=@rpa/contracts",
    "dev": "electron-vite dev",
    "predev": "npm run build --workspace=@rpa/contracts",
    "typecheck": "vue-tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "build": "npm run typecheck && electron-vite build",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:desktop": "vitest run --config vitest.desktop.config.ts",
    "pretypecheck": "npm run build --workspace=@rpa/contracts",
    "prebuild": "npm run build --workspace=@rpa/contracts",
    "test:ui": "electron-vite build && vitest run --config vitest.ui.config.ts",
    "pretest": "npm run build --workspace=@rpa/contracts",
    "pretest:browser": "npm run build --workspace=@rpa/contracts",
    "pretest:desktop": "npm run build --workspace=@rpa/contracts"
  },
  "keywords": [],
  "author": "Kable",
  "license": "MIT",
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.1.0",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/eslint-config-typescript": "^14.6.0",
    "autoprefixer": "^10.5.4",
    "electron": "^44.1.1",
    "electron-vite": "^5.0.0",
    "eslint": "^9.32.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-vue": "^10.3.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "vite": "^7.0.6",
    "vitest": "^2.0.5",
    "vue-tsc": "^3.0.4"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@rpa/contracts": "*",
    "@techstark/opencv-js": "^5.0.0-release.1",
    "@trpc/client": "^11.18.0",
    "ipaddr.js": "^2.5.0",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^3.0.3",
    "playwright": "^1.62.1",
    "quickjs-emscripten": "^0.32.0",
    "sharp": "^0.35.5",
    "typescript": "~5.8.3",
    "vue": "^3.5.18",
    "vue-router": "^4.5.1"
  }
}
